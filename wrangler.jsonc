{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sql-learn-web-app",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-24",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true
  }
}