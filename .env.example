# Public product configuration
VITE_PRODUCT_NAME=SQL Academy
VITE_SUPPORT_URL=
VITE_TERMS_URL=
VITE_PRIVACY_URL=
VITE_TURNSTILE_SITE_KEY=

# Worker public configuration
# Comma-separated exact origins. Wildcards and path-based entries are intentionally unsupported.
ALLOWED_ORIGINS=https://academy.example.com,http://localhost:4173,http://127.0.0.1:4173

# Optional integrations: all disabled unless explicitly enabled server-side
FEATURE_EMAIL_VERIFICATION=off
FEATURE_SMS_VERIFICATION=off
FEATURE_TURNSTILE=off
FEATURE_ADMIN_CONSOLE=off
TURNSTILE_EXPECTED_HOSTNAMES=academy.example.com
ADMIN_ALLOWED_USER_IDS=

# Verified-contact provider selectors. Keep disabled until the matching send
# credentials AND signed callback credentials have passed the protected staging workflow.
# Allowed email values: disabled, webhook, resend
# Allowed SMS values: disabled, webhook, twilio
EMAIL_VERIFICATION_PROVIDER=disabled
SMS_VERIFICATION_PROVIDER=disabled

# Verification signing/provider values below are Cloudflare secrets set with
# `wrangler secret put`; placeholders are intentionally empty.
CONTACT_VERIFICATION_SIGNING_SECRET=

# Generic buyer-owned webhook adapter
EMAIL_VERIFICATION_WEBHOOK_URL=
EMAIL_VERIFICATION_WEBHOOK_SECRET=
SMS_VERIFICATION_WEBHOOK_URL=
SMS_VERIFICATION_WEBHOOK_SECRET=

# Resend email adapter and signed event callback
RESEND_API_KEY=
RESEND_FROM=
RESEND_WEBHOOK_SECRET=

# Twilio SMS adapter and signed status callback
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=
TWILIO_STATUS_CALLBACK_URL=

# Protected staging Worker only. Never enable this route in production.
CONTACT_STAGING_MODE=disabled
CONTACT_STAGING_PROBE_SECRET=

# Cloudflare secret — set with `wrangler secret put`; never commit a real value.
TURNSTILE_SECRET_KEY=