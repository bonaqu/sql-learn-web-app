# Public product configuration
VITE_PRODUCT_NAME=SQL Academy
VITE_SUPPORT_URL=
VITE_TERMS_URL=
VITE_PRIVACY_URL=

# Worker public configuration
# Comma-separated exact origins. Wildcards and path-based entries are intentionally unsupported.
ALLOWED_ORIGINS=https://academy.example.com,http://localhost:4173,http://127.0.0.1:4173

# Optional integrations: all disabled unless explicitly enabled server-side
# A flag alone never advertises a capability until its production adapter exists.
FEATURE_EMAIL_VERIFICATION=off
FEATURE_SMS_VERIFICATION=off
FEATURE_TURNSTILE=off
FEATURE_ADMIN_CONSOLE=off

# Provider examples — set credentials as Cloudflare secrets, never commit real values
EMAIL_PROVIDER=disabled
EMAIL_API_KEY=
EMAIL_FROM=
SMS_PROVIDER=disabled
SMS_API_KEY=
SMS_FROM=
TURNSTILE_SECRET_KEY=
ADMIN_API_TOKEN=
