# Public product configuration
VITE_PRODUCT_NAME=SQL Academy
VITE_SUPPORT_URL=
VITE_TERMS_URL=
VITE_PRIVACY_URL=
VITE_TURNSTILE_SITE_KEY=

# Worker public configuration
# Comma-separated exact origins. Wildcards and path-based entries are intentionally unsupported.
ALLOWED_ORIGINS=https://academy.example.com,http://localhost:4173,http://127.0.0.1:4173

# Optional integrations: all disabled unless explicitly enabled server-side
FEATURE_EMAIL_VERIFICATION=off
FEATURE_SMS_VERIFICATION=off
FEATURE_TURNSTILE=off
FEATURE_ADMIN_CONSOLE=off
TURNSTILE_EXPECTED_HOSTNAMES=academy.example.com
ADMIN_ALLOWED_USER_IDS=

# Verified-contact delivery. In Cloudflare these five values are secrets set with
# `wrangler secret put`; never add a real destination, URL or credential to Git.
CONTACT_VERIFICATION_SIGNING_SECRET=
EMAIL_VERIFICATION_WEBHOOK_URL=
EMAIL_VERIFICATION_WEBHOOK_SECRET=
SMS_VERIFICATION_WEBHOOK_URL=
SMS_VERIFICATION_WEBHOOK_SECRET=

# Cloudflare secret — set with `wrangler secret put`; never commit a real value.
TURNSTILE_SECRET_KEY=
