{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sql-learn-web-app-typegen",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-27",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sql-academy",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SETTINGS",
      "id": "00000000000000000000000000000000"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "containers": [
    {
      "class_name": "Sandbox",
      "image": "./containers/dialect-engines/Dockerfile",
      "instance_type": "basic",
      "max_instances": 2
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "DIALECT_SANDBOX",
        "class_name": "Sandbox"
      }
    ]
  },
  "migrations": [
    {
      "tag": "dialect-sandbox-v1",
      "new_sqlite_classes": ["Sandbox"]
    }
  ],
  "vars": {
    "SANDBOX_TRANSPORT": "rpc",
    "SANDBOX_LOG_LEVEL": "warn",
    "SANDBOX_LOG_FORMAT": "json"
  }
}
