{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "lib": ["ES2022", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "worker/**/*.ts",
    "worker-configuration.d.ts",
    "src/data/dialect-lab-cases.ts",
    "src/data/dialect-lab-manifests.ts",
    "src/lib/dialect-lab-policy.ts"
  ]
}
